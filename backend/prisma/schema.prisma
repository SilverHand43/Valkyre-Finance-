generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum AccountPayableStatus {
  PENDING
  PAID
  OVERDUE
}

enum AccountReceivableStatus {
  PENDING
  RECEIVED
  OVERDUE
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

model Company {
  id                String            @id @default(uuid()) @db.Uuid
  fantasyName       String
  corporateName     String
  cnpj              String            @unique
  stateRegistration String?
  email             String
  phone             String
  cep               String
  address           String
  number            String
  district          String
  city              String
  state             String
  users             User[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  inventoryMovements InventoryMovement[]
  accountPayables   AccountPayable[]
  accountReceivables AccountReceivable[]
  cashFlows         CashFlow[]
  auditLogs         AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  companyId         String      @db.Uuid
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  email             String      @unique
  password          String
  phone             String
  role              UserRole
  active            Boolean     @default(true)
  refreshTokenHash  String?
  resetToken        String?
  resetTokenExpiresAt DateTime?
  inventoryMovements InventoryMovement[]
  cashFlows         CashFlow[]
  auditLogs         AuditLog[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([companyId])
  @@index([companyId, email])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  cpfCnpj    String
  email      String?
  phone      String?
  cep        String?
  address    String?
  city       String?
  state      String?
  notes      String?
  active     Boolean  @default(true)
  receivables AccountReceivable[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, cpfCnpj])
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  corporateName String
  fantasyName   String?
  cnpj          String
  email         String?
  phone         String?
  address       String?
  active        Boolean  @default(true)
  payables      AccountPayable[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, cnpj])
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku          String
  barcode      String?
  name         String
  description  String?
  category     String?
  costPrice    Decimal  @db.Decimal(14, 2)
  salePrice    Decimal  @db.Decimal(14, 2)
  quantity     Int      @default(0)
  minimumStock Int      @default(0)
  active       Boolean  @default(true)
  movements    InventoryMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, sku])
}

model InventoryMovement {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId  String                @db.Uuid
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int
  reason     String?
  userId     String                @db.Uuid
  user       User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime              @default(now())

  @@index([companyId])
  @@index([companyId, productId])
}

model AccountPayable {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @db.Uuid
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId  String?              @db.Uuid
  supplier    Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal              @db.Decimal(14, 2)
  dueDate     DateTime
  paymentDate DateTime?
  status      AccountPayableStatus @default(PENDING)
  category    String?
  createdAt   DateTime             @default(now())

  @@index([companyId])
  @@index([companyId, status])
}

model AccountReceivable {
  id          String                  @id @default(uuid()) @db.Uuid
  companyId   String                  @db.Uuid
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String?                 @db.Uuid
  customer    Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal                 @db.Decimal(14, 2)
  dueDate     DateTime
  paymentDate DateTime?
  status      AccountReceivableStatus @default(PENDING)
  category    String?
  createdAt   DateTime                @default(now())

  @@index([companyId])
  @@index([companyId, status])
}

model CashFlow {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        CashFlowType
  category    String?
  description String
  amount      Decimal      @db.Decimal(14, 2)
  date        DateTime
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([companyId])
  @@index([companyId, type])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  createdAt DateTime    @default(now())

  @@index([companyId])
  @@index([companyId, action])
}
